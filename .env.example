# ==============================================================================
# NODUS PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local to configure your local development environment:
#   cp .env.example .env.local
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit .env.local or any files containing actual secret keys to git.
# 2. NEVER prefix server secrets (like service role keys) with NEXT_PUBLIC_.
# 3. All privileged keys must be isolated to server contexts only.
# ==============================================================================

# ------------------------------------------------------------------------------
# WorkOS AuthKit
# ------------------------------------------------------------------------------
# Use the Staging client ID locally and the Production client ID in production.
WORKOS_CLIENT_ID=client_01M7T841PNMYSWF6CYPTWWK7MH
WORKOS_COOKIE_PASSWORD=generate-a-random-secret-at-least-32-characters-long
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
# Validate session tokens from both configured WorkOS environments.
WORKOS_ISSUER=https://api.workos.com/user_management/client_01M7T841PNMYSWF6CYPTWWK7MH,https://api.workos.com/user_management/client_01M7T841Y5D7AJZHVW8YSTJ9EG
# Optional. Nodus uses AuthKit's PKCE public-client flow and does not call WorkOS management APIs.
# Leave unset for keyless sign-in. If you set it, keep it server-only.
# WORKOS_API_KEY=

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tpyyofyhilufkjttizje.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_nAaQeIFKylUWDl9lBHKLJA_dB4JC49b
# Server-only service-role key. Required by the private CMS/Studio server routes.
# Never expose this key in browser code or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
# Local UI preview only. Requires localhost + NODE_ENV=development; never enable in production.
NODUS_DEV_AUTH_BYPASS=false

# Public WalletConnect Cloud project ID for Rabby Wallet mobile connections.
# Obtain one from https://cloud.walletconnect.com/; this is an app identifier, not a wallet secret.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ------------------------------------------------------------------------------
# Optional customer wallet configuration
# ------------------------------------------------------------------------------
# Optional managed Solana Mainnet RPC URL. The public Solana endpoint is used if unset.
NEXT_PUBLIC_SOLANA_RPC_URL=

# ------------------------------------------------------------------------------
# Payment Orchestration Configuration
# ------------------------------------------------------------------------------
# Payment mode: "mock" (default for demonstration)
PAYMENT_MODE=mock
# Note: Circle CCTP operates permissionlessly against smart contracts; no Circle API key is required.
# Server-side JSON maps of canonical destination network keys to HTTPS RPC endpoints
# and required confirmation counts for on-chain settlement verification.
# Canonical Circle checkout testnet keys: "sepolia", "base-sepolia", "arbitrum-sepolia", "optimism-sepolia", "arc-testnet"
# Canonical EVM mainnet keys: "ethereum", "base", "arbitrum", "optimism", "polygon", "avalanche"
# Example Circle checkout testnet configuration (use RPCs appropriate for your deployment):
# SETTLEMENT_RPC_URLS_JSON={"sepolia":"https://rpc.sepolia.org","base-sepolia":"https://sepolia.base.org","arbitrum-sepolia":"https://sepolia-rollup.arbitrum.io/rpc","optimism-sepolia":"https://sepolia.optimism.io"}
# SETTLEMENT_CONFIRMATIONS_JSON={"sepolia":2,"base-sepolia":2,"arbitrum-sepolia":2,"optimism-sepolia":2,"arc-testnet":2}
SETTLEMENT_RPC_URLS_JSON={}
SETTLEMENT_CONFIRMATIONS_JSON={}


# ------------------------------------------------------------------------------
# Private Nodus Studio CMS + website analytics
# ------------------------------------------------------------------------------
# One-time first-owner bootstrap for private /studio. Set either this WorkOS user ID
# or CMS_ADMIN_EMAILS to the first owner's verified WorkOS identity. The database
# role record is created on first sign-in only while cms_admin_users is empty.
# Remove the bootstrap value after the owner record is created.
CMS_ADMIN_WORKOS_SUBJECTS=
# Alternatively bootstrap the first owner with their verified WorkOS email.
CMS_ADMIN_EMAILS=
# Recommended: set a random 32+ character secret for hashing first-party anonymous analytics visitor tokens. Keep it server-only.
CMS_ANALYTICS_SECRET=
