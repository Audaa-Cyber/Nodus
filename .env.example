# ==============================================================================
# NODUS PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local to configure your local development environment:
#   cp .env.example .env.local
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit .env.local or any files containing actual secret keys to git.
# 2. NEVER prefix server secrets (like service role keys) with NEXT_PUBLIC_.
# 3. All privileged keys must be isolated to server contexts only.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Public credentials accessible to browser and server components.
# Obtain these from your Supabase project settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# CRITICAL SECURITY: Server-only Service Role Key.
# Grants admin/bypassed RLS database access.
# NEVER expose this key to browser client code.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Optional customer wallet configuration
# ------------------------------------------------------------------------------
# Optional managed Solana Mainnet RPC URL. The public Solana endpoint is used if unset.
NEXT_PUBLIC_SOLANA_RPC_URL=

# ------------------------------------------------------------------------------
# NEAR Intents 1Click configuration
# ------------------------------------------------------------------------------
# Current MVP remains in mock mode. Production live quoting/execution must stay
# disabled until 1Click asset/route/wallet verification and a full transaction review
# are complete. Tidepool is a separate, isolated testnet mode.
# Never expose this token through a NEXT_PUBLIC_ variable.
PAYMENT_MODE=mock
ONE_CLICK_JWT=
# Keep false until live USDC routes and wallet execution are verified and reviewed.
LIVE_PAYMENT_ENABLED=false
# Comma-separated exact 1Click USDC asset IDs verified by dry-run quotes and review.
LIVE_VERIFIED_USDC_ASSET_IDS=
# Required only after a live route has been reviewed. Server-side JSON maps of canonical
# destination network keys to HTTPS RPC endpoints and required confirmation counts.
# Example placeholders (do not use these as production RPC credentials):
SETTLEMENT_RPC_URLS_JSON={}
SETTLEMENT_CONFIRMATIONS_JSON={}

# ------------------------------------------------------------------------------
# Tidepool testnet isolation (leave disabled until separately reviewed)
# ------------------------------------------------------------------------------
# To use Tidepool, start the local Supabase stack and replace the three standard
# Supabase values above with the local API URL and keys printed by `supabase status`.
# Tidepool mode rejects non-loopback Supabase URLs. Never use hosted credentials.
SUPABASE_ENVIRONMENT=development
# Tidepool's public testnet API; this URL is not a credential.
TIDEPOOL_API_BASE_URL=https://www.usetidepool.tech
# Keep false until Tidepool's maker signature key/format is confirmed and local test
# database isolation is verified. No deposit endpoint is enabled by this scaffold.
TIDEPOOL_DEPOSITS_ENABLED=false
# Set only after verifying the published maker key and exact signing/canonicalization
# specification with Tidepool. Never use the official 1Click verifier for Tidepool.
TIDEPOOL_QUOTE_SIGNATURE_VERIFICATION=unconfirmed
TIDEPOOL_MAKER_PUBLIC_KEY=

# All NEAR private keys and privileged API credentials must remain server-only.
# NEAR_NETWORK_ID=testnet
# NEAR_RPC_URL=https://rpc.testnet.near.org
# NEAR_INTENTS_CONTRACT_ID=
# NEAR_SIGNER_ACCOUNT_ID=
# NEAR_SIGNER_PRIVATE_KEY=

