# ==============================================================================
# NODUS PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local to configure your local development environment:
#   cp .env.example .env.local
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit .env.local or any files containing actual secret keys to git.
# 2. NEVER prefix server secrets (like service role keys) with NEXT_PUBLIC_.
# 3. All privileged keys must be isolated to server contexts only.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Public credentials accessible to browser and server components.
# Obtain these from your Supabase project settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# CRITICAL SECURITY: Server-only Service Role Key.
# Grants admin/bypassed RLS database access.
# NEVER expose this key to browser client code.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Circle User-Controlled Wallets Configuration (Optional Wallet Method)
# ------------------------------------------------------------------------------
# Server-only Circle API Key for User-Controlled Wallets Web3 Services.
# NEVER prefix with NEXT_PUBLIC_.
CIRCLE_API_KEY=
# Application ID configured in Circle Developer Console for Web SDK challenges.
NEXT_PUBLIC_CIRCLE_APP_ID=
CIRCLE_API_BASE_URL=https://api.circle.com

# ------------------------------------------------------------------------------
# Optional customer wallet configuration
# ------------------------------------------------------------------------------
# Optional managed Solana Mainnet RPC URL. The public Solana endpoint is used if unset.
NEXT_PUBLIC_SOLANA_RPC_URL=

# ------------------------------------------------------------------------------
# Payment Orchestration Configuration
# ------------------------------------------------------------------------------
# Payment mode: "mock" (default for demonstration)
PAYMENT_MODE=mock
# Note: Circle CCTP operates permissionlessly against smart contracts; no Circle API key is required.
# Server-side JSON maps of canonical destination network keys to HTTPS RPC endpoints
# and required confirmation counts for on-chain settlement verification.
# Canonical Circle checkout testnet keys: "sepolia", "base-sepolia", "arbitrum-sepolia", "optimism-sepolia"
# Canonical EVM mainnet keys: "ethereum", "base", "arbitrum", "optimism", "polygon", "avalanche"
# Example Circle checkout testnet configuration (use RPCs appropriate for your deployment):
# SETTLEMENT_RPC_URLS_JSON={"sepolia":"https://rpc.sepolia.org","base-sepolia":"https://sepolia.base.org","arbitrum-sepolia":"https://sepolia-rollup.arbitrum.io/rpc","optimism-sepolia":"https://sepolia.optimism.io"}
# SETTLEMENT_CONFIRMATIONS_JSON={"sepolia":2,"base-sepolia":2,"arbitrum-sepolia":2,"optimism-sepolia":2}
SETTLEMENT_RPC_URLS_JSON={}
SETTLEMENT_CONFIRMATIONS_JSON={}

# All NEAR Chain Signatures (MPC) keys and RPC credentials must remain server-only.
# Settlement outbox signer is also testnet-only. Keep the private key in the
# deployment secret manager; never add a real value to this example or client env.
NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_CONTRACT_ID=noduss.testnet
NEAR_SIGNER_ACCOUNT_ID=noduss.testnet
NEAR_SIGNER_PRIVATE_KEY=ed25519:<server-only-testnet-private-key>
NEAR_OUTBOX_WORKER_SECRET=<server-only-random-worker-secret>

